// Editor screen: path bar, Frame/Thumbnail preview with split Save button,
// filmstrip and timeline (main_window.py, preview_widget.py,
// filmstrip_widget.py, timeline_widget.py).

import { Theme } from "theme.slint";
import { OpenFolderIcon, SaveGlyph, Spinner, WarningIcon, ChevronDown, PictureGlyph, PlayGlyph, PauseGlyph, InfoGlyph, FitGlyph, CropGlyph } from "icons.slint";

export struct FilmTile {
    x: length,
    width: length,
    image: image,
    has-image: bool,
    selected: bool,
}

component OpenButton inherits Rectangle {
    callback clicked();
    width: Theme.mobile ? 40px : 24px;
    height: Theme.mobile ? 40px : 24px;
    accessible-role: button;
    accessible-label: "Open video file";
    accessible-action-default => { root.clicked(); }
    border-radius: 4px;
    background: touch.pressed ? #80808040 : touch.has-hover ? #80808026 : transparent;
    OpenFolderIcon { width: Theme.mobile ? 24px : 18px; height: self.width; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("Open video file"); }
}

export component PathBar inherits HorizontalLayout {
    in property <string> path;
    callback open-clicked();
    callback path-clicked();
    spacing: 8px;

    OpenButton { clicked => { root.open-clicked(); } }
    // The text only takes the width it needs, so blank space next to it is
    // not clickable; it wraps when the window is narrower than the path.
    path-text := Text {
        text: root.path;
        font-size: 12px;
        color: Theme.path-text;
        wrap: word-wrap;
        vertical-alignment: center;
        horizontal-stretch: 0;
        accessible-role: button;
        accessible-action-default => { root.path-clicked(); }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.path-clicked(); }
        }
        Tooltip { text: @markdown("Show video in containing folder"); }
    }
    Rectangle { horizontal-stretch: 1; }
}

component Panel inherits Rectangle {
    in property <string> title;
    in property <bool> title-visible: true;
    // Size of the area under the title. Children of a Panel see the Panel
    // itself as `parent`, so they size themselves with these.
    out property <length> content-width: content.width;
    out property <length> content-height: content.height;
    background: Theme.panel-background;
    border-width: 1px;
    border-color: Theme.panel-border;
    border-radius: 4px;
    VerticalLayout {
        padding: 4px;
        spacing: 2px;
        if root.title-visible: Text {
            text: root.title;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
            color: Theme.text;
        }
        content := Rectangle {
            vertical-stretch: 1;
            @children
        }
    }
}

component Placeholder inherits Text {
    font-italic: true;
    color: grey;
    font-size: 13px;
    horizontal-alignment: center;
    vertical-alignment: center;
    wrap: word-wrap;
}

component PanelImage inherits Image {
    image-fit: contain;
    image-rendering: smooth;
}

// Outlined secondary button of the editor rows (as tall as the Save button).
component ToolButton inherits Rectangle {
    in property <string> text;
    in property <string> tooltip;
    in property <string> accessible-text: root.text;
    in property <bool> enabled: true;
    in property <bool> show-icon;
    callback clicked();

    height: Theme.control-height;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.panel-border;
    background: !root.enabled ? transparent
        : touch.pressed ? #80808040
        : touch.has-hover ? #80808026 : Theme.panel-background;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.accessible-text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    HorizontalLayout {
        padding-left: root.text == "" ? 8px : 12px;
        padding-right: root.text == "" ? 8px : 12px;
        spacing: 6px;
        if root.show-icon: VerticalLayout {
            alignment: center;
            PictureGlyph { width: 18px; height: 18px; }
        }
        if root.text != "": Text {
            text: root.text;
            font-size: 13px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.tooltip != "": Tooltip { text: @markdown("\{root.tooltip}"); }
}

component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked();

    border-radius: 4px;
    background: root.selected ? Theme.primary
        : root.enabled && touch.has-hover ? #80808026 : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-checkable: true;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            font-size: 13px;
            color: root.selected ? white : Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && !root.selected;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// "Fit to frame | Crop to frame" switch shown while an image is the source.
component FitSwitch inherits Rectangle {
    in property <bool> crop;
    in property <bool> enabled: true;
    callback changed(bool);

    height: Theme.control-height;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.panel-border;
    background: Theme.panel-background;
    opacity: root.enabled ? 1 : 0.5;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        Segment {
            text: "Fit to frame";
            selected: !root.crop;
            enabled: root.enabled;
            clicked => { root.changed(false); }
            Tooltip { text: @markdown("Show the whole image, with bars where its shape differs from the video"); }
        }
        Segment {
            text: "Crop to frame";
            selected: root.crop;
            enabled: root.enabled;
            clicked => { root.changed(true); }
            Tooltip { text: @markdown("Fill the whole frame, cutting off the image's edges"); }
        }
    }
}

export component SaveButton inherits Rectangle {
    in property <bool> enabled;
    in property <string> text;
    in property <bool> saving;
    in property <string> tooltip;
    callback save-copy();
    callback overwrite();

    // Phones only save copies: the open video is the app's private copy of
    // the picked file, so there is no original to overwrite.
    property <bool> has-menu: !Theme.mobile;
    property <length> menu-width: root.has-menu ? 34px : 0px;

    width: Theme.mobile ? 104px : 210px;
    height: Theme.control-height;
    border-radius: 6px;
    border-width: 1px;
    border-color: enabled ? Theme.primary-border : Theme.primary-disabled;
    background: !enabled ? Theme.primary-disabled
        : main-touch.pressed ? Theme.primary-pressed
        : main-touch.has-hover ? Theme.primary-hover : Theme.primary;
    accessible-role: button;
    accessible-label: "Save thumbnail";
    accessible-enabled: root.enabled;
    accessible-action-default => { root.save-copy(); }

    main-touch := TouchArea {
        x: 0;
        width: parent.width - root.menu-width;
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.save-copy(); }
    }
    // Menu half
    if root.has-menu: Rectangle {
        x: parent.width - 34px;
        width: 34px;
        border-top-right-radius: 6px;
        border-bottom-right-radius: 6px;
        accessible-role: button;
        accessible-label: "Save options";
        accessible-enabled: root.enabled;
        accessible-action-default => { if root.enabled { menu.show(); } }
        background: !root.enabled ? transparent
            : menu-touch.pressed ? Theme.primary-pressed
            : menu-touch.has-hover ? Theme.primary-hover : transparent;
        Rectangle {
            x: 0;
            width: 1px;
            background: root.enabled ? Theme.primary-border : #ffffff60;
        }
        ChevronDown { width: 14px; height: 14px; }
        menu-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { menu.show(); }
        }
    }
    HorizontalLayout {
        x: 0;
        width: parent.width - root.menu-width;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            if !root.saving: SaveGlyph { width: 20px; height: 20px; }
            if root.saving: Spinner { width: 20px; height: 20px; running: root.saving; }
        }
        Text {
            text: root.text;
            color: white;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    Tooltip { text: @markdown("\{root.tooltip}"); }

    menu := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        close-policy: close-on-click;
        Rectangle {
            background: Theme.panel-background;
            border-width: 1px;
            border-color: Theme.panel-border;
            border-radius: 6px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: 4px;
                for item[index] in ["Save a copy", "Overwrite original…"]: Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    accessible-role: button;
                    accessible-label: item;
                    accessible-action-default => {
                        if index == 0 { root.save-copy(); } else { root.overwrite(); }
                            menu.close();
                    }
                    background: item-touch.has-hover ? #80808026 : transparent;
                    Text {
                        x: 12px;
                        text: item;
                        font-size: 13px;
                        vertical-alignment: center;
                        color: Theme.text;
                    }
                    item-touch := TouchArea {
                        clicked => {
                            if index == 0 { root.save-copy(); } else { root.overwrite(); }
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

// Borderless phone button around a glyph; `selected` fills it.
component IconButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> selected;
    callback clicked();

    width: 40px;
    height: 40px;
    border-radius: 6px;
    background: root.selected ? Theme.primary : touch.pressed ? #80808040 : transparent;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-checked: root.selected;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            alignment: center;
            @children
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Phone thumbnail source buttons: pick a picture and, once one is used, fit
// it to the frame or crop it.
component MobileImageButtons inherits Rectangle {
    in property <bool> vertical;
    in property <bool> saving;
    in property <bool> image-mode;
    in property <bool> image-crop;
    callback open-image();
    callback set-image-crop(bool);

    property <length> size: root.vertical ? 36px : 40px;
    property <length> spacing: root.vertical ? 2px : 4px;
    property <int> count: root.image-mode ? 3 : 1;
    width: root.vertical ? root.size : root.count * root.size + (root.count - 1) * root.spacing;
    height: root.vertical ? root.count * root.size + (root.count - 1) * root.spacing : root.size;

    IconButton {
        x: 0;
        y: 0;
        width: root.size;
        height: root.size;
        label: root.image-mode ? "Choose another image" : "Use image";
        enabled: !root.saving;
        clicked => { root.open-image(); }
        PictureGlyph { width: 24px; height: 24px; }
    }
    if root.image-mode: IconButton {
        x: root.vertical ? 0 : root.size + root.spacing;
        y: root.vertical ? root.size + root.spacing : 0;
        width: root.size;
        height: root.size;
        label: "Fit to frame";
        selected: !root.image-crop;
        enabled: !root.saving;
        clicked => { root.set-image-crop(false); }
        FitGlyph { width: 24px; height: 24px; tint: !root.image-crop ? white : Theme.text; }
    }
    if root.image-mode: IconButton {
        x: root.vertical ? 0 : 2 * (root.size + root.spacing);
        y: root.vertical ? 2 * (root.size + root.spacing) : 0;
        width: root.size;
        height: root.size;
        label: "Crop to frame";
        selected: root.image-crop;
        enabled: !root.saving;
        clicked => { root.set-image-crop(true); }
        CropGlyph { width: 24px; height: 24px; tint: root.image-crop ? white : Theme.text; }
    }
}

// Phone About button (it stands in for the desktop footer).
component AboutButton inherits Rectangle {
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 4px;
    background: touch.pressed ? #80808040 : transparent;
    accessible-role: button;
    accessible-label: "About FrameCover";
    accessible-action-default => { root.clicked(); }
    InfoGlyph { width: 24px; height: 24px; }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component Preview inherits Rectangle {
    in property <string> frame-title;
    in property <image> frame-image;
    in property <bool> has-frame;
    in property <image> thumb-image;
    in property <bool> has-thumb;
    in property <bool> progress-visible;
    in property <string> progress-text;
    in property <bool> save-enabled;
    in property <string> save-text;
    in property <bool> saving;
    in property <string> save-tooltip;
    in property <bool> reencode-visible;
    in property <string> saved-label;
    in property <bool> image-mode;
    in property <bool> image-crop;
    callback save-copy();
    callback overwrite();
    callback show-reencode-reason();
    callback open-image();
    callback use-video-frame();
    callback set-image-crop(bool);
    /// A swipe over the frame: one frame back (-1) or forward (1).
    callback step-frame(int);
    // Phones only: buttons in the Frame panel.
    callback open-file();
    callback show-about();

    // Two equal columns, positioned manually so image sizes never feed back
    // into the window layout. Phones have no room for the Thumbnail panel:
    // the frame takes the whole area, between About and Open on one side and
    // the image button and Save on the other: above and below it when the
    // phone is upright, left and right of it when sideways. The frame time
    // is under the timeline.
    property <bool> landscape: Theme.mobile && root.width > root.height;
    property <length> side-button-width: 104px;
    property <length> left-width: root.landscape ? Theme.control-height + 6px : 0px;
    property <length> right-width: root.landscape ? root.side-button-width + 6px : 0px;
    property <length> header-height: Theme.mobile && !root.landscape ? Theme.control-height + 4px : 0px;
    property <length> footer-height: root.header-height;
    property <length> column-width: Theme.mobile ? root.width - 2 * 4px : (root.width - 2 * 4px - 8px) / 2;
    property <length> column-height: root.height - 8px;
    // Finger travel per frame step.
    property <length> swipe-step: 20px;
    // Small enough for a phone held sideways.
    min-height: Theme.mobile ? 120px : 220px;
    preferred-height: Theme.mobile ? 360px : 220px;
    VerticalLayout {
        x: 4px;
        y: 4px;
        width: root.column-width;
        height: root.column-height;
        spacing: 8px;
        Panel {
            vertical-stretch: 1;
            title: root.frame-title;
            title-visible: !Theme.mobile;
            if Theme.mobile && !root.landscape: HorizontalLayout {
                y: 0;
                width: parent.content-width;
                height: Theme.control-height;
                spacing: 6px;
                alignment: start;
                AboutButton {
                    y: (Theme.control-height - self.height) / 2;
                    clicked => { root.show-about(); }
                }
                OpenButton {
                    y: (Theme.control-height - self.height) / 2;
                    clicked => { root.open-file(); }
                }
                MobileImageButtons {
                    y: (Theme.control-height - self.height) / 2;
                    saving: root.saving;
                    image-mode: root.image-mode;
                    image-crop: root.image-crop;
                    open-image => { root.open-image(); }
                    set-image-crop(crop) => { root.set-image-crop(crop); }
                }
            }
            if root.landscape: VerticalLayout {
                x: 0;
                y: 0;
                width: Theme.control-height;
                height: parent.content-height;
                spacing: 6px;
                alignment: start;
                AboutButton { clicked => { root.show-about(); } }
                OpenButton { clicked => { root.open-file(); } }
                MobileImageButtons {
                    vertical: true;
                    saving: root.saving;
                    image-mode: root.image-mode;
                    image-crop: root.image-crop;
                    open-image => { root.open-image(); }
                    set-image-crop(crop) => { root.set-image-crop(crop); }
                }
            }
            if root.has-frame: PanelImage {
                x: root.left-width;
                y: root.header-height;
                width: parent.content-width - root.left-width - root.right-width;
                height: parent.content-height - root.header-height - root.footer-height;
                source: root.frame-image;
            }
            if !root.has-frame: Placeholder {
                x: root.left-width;
                y: root.header-height;
                width: parent.content-width - root.left-width - root.right-width;
                height: parent.content-height - root.header-height - root.footer-height;
                text: "No frame selected";
            }
            if Theme.mobile && !root.landscape: HorizontalLayout {
                y: parent.content-height - Theme.control-height;
                width: parent.content-width;
                height: Theme.control-height;
                spacing: 6px;
                // How long the last save took, or the picked image's name.
                Text {
                    text: root.saved-label != "" ? root.saved-label : root.image-mode ? root.frame-title : "";
                    font-size: 12px;
                    color: Theme.path-text;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                    min-width: 0px;
                }
                if root.reencode-visible: Rectangle {
                    width: 32px;
                    accessible-role: button;
                    accessible-label: "Video re-encoding warning";
                    accessible-action-default => { root.show-reencode-reason(); }
                    WarningIcon { width: 20px; height: 20px; }
                    TouchArea { clicked => { root.show-reencode-reason(); } }
                }
                SaveButton {
                    enabled: root.save-enabled;
                    text: root.saving ? "" : "Save";
                    saving: root.saving;
                    save-copy => { root.save-copy(); }
                }
            }
            if root.landscape: VerticalLayout {
                x: parent.content-width - root.side-button-width;
                y: 0;
                width: root.side-button-width;
                height: parent.content-height;
                spacing: 6px;
                Rectangle { vertical-stretch: 1; }
                if root.reencode-visible: Rectangle {
                    height: 32px;
                    accessible-role: button;
                    accessible-label: "Video re-encoding warning";
                    accessible-action-default => { root.show-reencode-reason(); }
                    WarningIcon { width: 20px; height: 20px; }
                    TouchArea { clicked => { root.show-reencode-reason(); } }
                }
                Text {
                    text: root.saved-label != "" ? root.saved-label : root.image-mode ? root.frame-title : "";
                    font-size: 12px;
                    color: Theme.path-text;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                SaveButton {
                    enabled: root.save-enabled;
                    text: root.saving ? "" : "Save";
                    saving: root.saving;
                    save-copy => { root.save-copy(); }
                }
            }
            // Swiping right moves the selection a frame later, left earlier,
            // a frame per `swipe-step` of travel.
            if root.has-frame && !root.image-mode: TouchArea {
                x: root.left-width;
                y: root.header-height;
                width: parent.content-width - root.left-width - root.right-width;
                height: parent.content-height - root.header-height - root.footer-height;
                property <length> anchor;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        self.anchor = self.mouse-x;
                    }
                }
                moved => {
                    if self.mouse-x - self.anchor >= root.swipe-step {
                        self.anchor += root.swipe-step;
                        root.step-frame(1);
                    } else if self.anchor - self.mouse-x >= root.swipe-step {
                        self.anchor -= root.swipe-step;
                        root.step-frame(-1);
                    }
                }
            }
        }
        // Thumbnail source: a video frame, or an image file fitted or
        // cropped to the frame.
        if !Theme.mobile: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if !root.image-mode: ToolButton {
                text: "Use image…";
                show-icon: true;
                enabled: !root.saving;
                tooltip: "Use a picture file as the thumbnail (Ctrl+I). You can also drop a picture onto the window.";
                clicked => { root.open-image(); }
            }
            if root.image-mode: FitSwitch {
                crop: root.image-crop;
                enabled: !root.saving;
                changed(crop) => { root.set-image-crop(crop); }
            }
            if root.image-mode: ToolButton {
                text: "Use video frame";
                enabled: !root.saving;
                tooltip: "Go back to using a frame of the video. Clicking the timeline or the filmstrip does the same.";
                clicked => { root.use-video-frame(); }
            }
            if root.image-mode: ToolButton {
                show-icon: true;
                accessible-text: "Choose another image";
                enabled: !root.saving;
                tooltip: "Choose another image (Ctrl+I)";
                clicked => { root.open-image(); }
            }
        }
    }
    if !Theme.mobile: VerticalLayout {
        x: 4px + root.column-width + 8px;
        y: 4px;
        width: root.column-width;
        height: root.column-height;
        spacing: 8px;
        Panel {
            vertical-stretch: 1;
            title: "Thumbnail";
            if root.progress-visible: progress := Flickable {
                content-height: max(progress-label.preferred-height + 8px, self.height);
                content-y: min(0px, self.height - self.content-height);
                progress-label := Text {
                    x: 6px;
                    y: 4px;
                    height: self.preferred-height;
                    vertical-alignment: top;
                    width: parent.width - 12px;
                    text: root.progress-text;
                    font-size: 12px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
            }
            if !root.progress-visible && root.has-thumb: PanelImage {
                // The thumbnail is drawn a little smaller than the frame.
                width: parent.content-width * 0.9;
                height: parent.content-height * 0.9;
                source: root.thumb-image;
            }
            if !root.progress-visible && !root.has-thumb: Placeholder {
                text: "No preview yet. Select a frame, then press Save thumbnail.";
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            SaveButton {
                enabled: root.save-enabled;
                text: root.save-text;
                saving: root.saving;
                tooltip: root.save-tooltip;
                save-copy => { root.save-copy(); }
                overwrite => { root.overwrite(); }
            }
            if root.reencode-visible: Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 4px;
                background: warn-touch.has-hover ? #80808026 : transparent;
                accessible-role: button;
                accessible-label: "Video re-encoding warning";
                accessible-action-default => { root.show-reencode-reason(); }
                WarningIcon { width: 20px; height: 20px; }
                warn-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-reencode-reason(); }
                }
                Tooltip { text: @markdown("Why will this video be re-encoded?"); }
            }
            if root.saved-label != "": Text {
                text: root.saved-label;
                font-size: 12px;
                color: Theme.path-text;
                vertical-alignment: center;
            }
        }
    }
}

export component Filmstrip inherits Rectangle {
    in property <[FilmTile]> tiles;
    callback clicked(length);
    callback resized(length);

    height: 80px;
    changed width => { root.resized(self.width); }
    init => { root.resized(self.width); }

    for tile in root.tiles: Rectangle {
        x: tile.x;
        y: (root.height - 72px) / 2;
        width: tile.width;
        height: 72px;
        background: Theme.tile-background;
        border-width: tile.selected ? 2px : 1px;
        border-color: tile.selected ? Theme.tile-selected : Theme.tile-border;
        if tile.has-image: Image {
            x: 3px;
            y: 3px;
            width: parent.width - 6px;
            height: parent.height - 6px;
            source: tile.image;
            image-fit: contain;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(self.mouse-x); }
    }
}

export component Timeline inherits Rectangle {
    in property <bool> enabled;
    in property <float> fill;
    in property <string> label;
    in property <bool> has-duration;
    /// Pointer at `ratio` of the width; `released` on button release.
    callback pointer(float, bool);
    /// Lowest track centre, so a button beside it can be centred on it.
    in property <length> min-track-y;

    // Phones: a larger handle and touch strip.
    property <length> handle: Theme.mobile ? 24px : 16px;
    out property <length> track-y: max(root.handle / 2 + 2px, root.min-track-y);
    height: root.track-y + root.handle / 2 + 2px + 14px + 4px;
    property <length> fill-width: root.width * clamp(root.fill, 0, 1);

    Rectangle {
        y: track-y - 3px;
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
    }
    if root.has-duration: Rectangle {
        x: 0;
        y: track-y - 3px;
        width: fill-width;
        height: 6px;
        border-radius: 3px;
        background: Theme.track-fill;
    }
    if root.has-duration: Rectangle {
        x: fill-width - root.handle / 2;
        y: track-y - root.handle / 2;
        width: root.handle;
        height: root.handle;
        border-radius: root.handle / 2;
        background: Theme.handle;
        border-width: 2px;
        border-color: white;
    }
    Text {
        y: track-y + root.handle / 2 + 2px;
        height: 14px;
        width: parent.width;
        text: root.label;
        font-size: 12px;
        horizontal-alignment: center;
        color: Theme.timeline-label;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left {
                if event.kind == PointerEventKind.down {
                    root.pointer(self.mouse-x / max(1px, self.width), false);
                } else if event.kind == PointerEventKind.up {
                    root.pointer(self.mouse-x / max(1px, self.width), true);
                }
            }
        }
        moved => {
            if self.pressed {
                root.pointer(self.mouse-x / max(1px, self.width), false);
            }
        }
    }
}

// Play/pause button left of the timeline.
export component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <bool> enabled;
    callback clicked();

    width: Theme.mobile ? 40px : 28px;
    height: self.width;
    border-radius: self.width / 2;
    background: !root.enabled ? transparent
        : touch.pressed ? #80808040
        : touch.has-hover ? #80808026 : transparent;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.playing ? "Pause" : "Play";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    if root.playing: PauseGlyph { width: root.width * 0.7; height: root.height * 0.7; }
    if !root.playing: PlayGlyph { width: root.width * 0.7; height: root.height * 0.7; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.playing ? "Pause" : "Play from here"} (Space)"); }
}
