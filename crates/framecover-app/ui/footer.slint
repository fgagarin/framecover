// Bottom bar: name and version (opens About), project link, update status (AppFooter).

import { Theme } from "theme.slint";
import { StatusDot } from "icons.slint";

component FooterText inherits Text {
    font-size: 12px;
    color: Theme.muted;
    vertical-alignment: center;
}

component Separator inherits Rectangle {
    width: 1px;
    height: 14px;
    background: Theme.separator;
}

component Link inherits Rectangle {
    in property <string> text;
    in property <string> tooltip;
    /// Muted until hovered (for the app name), instead of always link-coloured.
    in property <bool> subtle;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        spacing: 3px;
        label := FooterText {
            text: root.text;
            color: !root.subtle || touch.has-hover ? Theme.link : Theme.muted;
        }
        @children
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if root.tooltip != "": Tooltip { text: @markdown("\{root.tooltip}"); }
}

export component AppFooter inherits HorizontalLayout {
    in property <string> version;
    in property <string> project-url;
    in property <bool> status-visible;
    in property <string> status-text;
    in property <string> status-tooltip;
    in property <bool> status-enabled: true;
    in property <color> status-color;
    callback open-project-page();
    callback show-about();
    callback status-clicked();

    padding-left: 4px;
    spacing: 12px;
    height: 28px;

    Link {
        text: "FrameCover " + root.version;
        tooltip: "About FrameCover";
        subtle: true;
        clicked => { root.show-about(); }
    }
    VerticalLayout { alignment: center; Separator { } }
    Link {
        text: "Project page";
        tooltip: root.project-url;
        clicked => { root.open-project-page(); }
        FooterText { text: "↗"; }
    }
    Rectangle { horizontal-stretch: 1; }

    if root.status-visible: status := Rectangle {
        property <bool> active: touch.has-hover && root.status-enabled;
        horizontal-stretch: 0;
        border-radius: 13px;
        background: active ? #80808026 : transparent;
        accessible-role: button;
        accessible-label: root.status-text;
        accessible-enabled: root.status-enabled;
        accessible-action-default => { if root.status-enabled { root.status-clicked(); } }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                StatusDot { tint: root.status-color; }
            }
            FooterText {
                text: root.status-text;
                color: !root.status-enabled ? #80808090 : status.active ? Theme.link : Theme.muted;
            }
        }
        touch := TouchArea {
            mouse-cursor: root.status-enabled ? MouseCursor.pointer : MouseCursor.default;
            enabled: root.status-enabled;
            clicked => { root.status-clicked(); }
        }
        Tooltip { text: @markdown("\{root.status-tooltip}"); }
    }
}
