{
  "case": "resave_mp4",
  "commands": [
    {
      "argv": [
        "<FFMPEG>",
        "-y",
        "-loop",
        "1",
        "-framerate",
        "25/1",
        "-i",
        "<WORK>/.vt_frame_XXXXXXXX.png",
        "-frames:v",
        "1",
        "-vf",
        "scale=320:240:flags=lanczos",
        "-an",
        "-sn",
        "-c:v",
        "libx264",
        "-profile:v",
        "high",
        "-pix_fmt",
        "yuv420p",
        "-video_track_timescale",
        "12800",
        "-f",
        "mp4",
        "<WORK>/.vt_preview_XXXXXXXX.mp4"
      ],
      "returncode": 0
    },
    {
      "argv": [
        "<FFMPEG>",
        "-y",
        "-f",
        "concat",
        "-safe",
        "0",
        "-i",
        "<WORK>/.vt_concat_XXXXXXXX.txt",
        "-itsoffset",
        "0.04",
        "-i",
        "<WORK>/.sample-thumbnail.save-XXXXXXXX.mp4",
        "-i",
        "<WORK>/.vt_cover_XXXXXXXX.jpg",
        "-map",
        "0:v:0",
        "-map",
        "1:a?",
        "-map",
        "1:s?",
        "-map",
        "2:v:0",
        "-map_metadata",
        "1",
        "-map_chapters",
        "1",
        "-c",
        "copy",
        "-disposition:v:1",
        "attached_pic",
        "-f",
        "mp4",
        "<WORK>/.vt_XXXXXXXX.tmp"
      ],
      "returncode": 0,
      "concat_manifest": [
        "file '<WORK>/.vt_preview_XXXXXXXX.mp4'",
        "duration 0.04",
        "file '<WORK>/.sample-thumbnail.save-XXXXXXXX.mp4'"
      ]
    },
