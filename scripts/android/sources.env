# Pinned sources for build-ffmpeg.sh: <NAME>_URL, <NAME>_REF (tag or branch
# cloned at depth 1) and <NAME>_COMMIT (the commit the ref must resolve to; a
# mismatch aborts the build, so a moved tag or branch is never built silently).

# FFmpeg 8.1 branch, matching the desktop builds in xtask/ffmpeg-pins.toml.
FFMPEG_URL=https://git.ffmpeg.org/ffmpeg.git
FFMPEG_REF=n8.1.3
FFMPEG_COMMIT=1041abdc962f4cc4f394aa8de9dc5236c0c3b9e7

# x264 publishes no release tags; `stable` is its release branch.
X264_URL=https://code.videolan.org/videolan/x264.git
X264_REF=stable
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55

X265_URL=https://bitbucket.org/multicoreware/x265_git.git
X265_REF=4.2
X265_COMMIT=e444744c03978c1fb4e037168967020cf2648427

AOM_URL=https://aomedia.googlesource.com/aom
AOM_REF=v3.15.2
AOM_COMMIT=af3dc9aadc793c1b00edc003e3fc19a44fdeb574

DAV1D_URL=https://code.videolan.org/videolan/dav1d.git
DAV1D_REF=1.5.4
DAV1D_COMMIT=54706fc6bc0cdecab7e9593974a4039cc038fca7

ZIMG_URL=https://github.com/sekrit-twc/zimg.git
ZIMG_REF=release-3.0.6
ZIMG_COMMIT=f819b14e8f39d1282400b0d9543e8ef73c1b2bbd
